# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tripsync
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/tripsync

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ─── App ───────────────────────────────────────────────────
APP_NAME="Trawell Buddy"
ENVIRONMENT=development
DEBUG=true
PORT=4010
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api/v1

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=30

# ─── AWS S3 ────────────────────────────────────────────────
S3_BUCKET=tripsync-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=

# ─── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Email (ZeptoMail) ─────────────────────────────────────
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=your-zeptomail-key
ZEPTOMAIL_FROM_ADDRESS=noreply@trawellbuddy.com
ZEPTOMAIL_FROM_NAME="Trawell Buddy"

# ─── Email Fallback (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@email.com
SMTP_PASSWORD=your-password
SMTP_TEST_SECRET=

# ─── WhatsApp (MSG91) ──────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-key
MSG91_TEMPLATE_ID=your-template-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_API_VERSION=v22.0

# ─── GST Verification ──────────────────────────────────────
GSTINCHECK_API_KEY=your-gstincheck-key

# ─── DigiLocker ────────────────────────────────────────────
DIGILOCKER_VERIFY_URL=https://api.digilocker.gov.in/...
DIGILOCKER_CLIENT_ID=your-client-id
DIGILOCKER_CLIENT_SECRET=your-client-secret

# ─── Encryption ────────────────────────────────────────────
ENCRYPTION_KEY=32-byte-hex-encryption-key-here

# ─── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
