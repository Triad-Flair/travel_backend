# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tripsync:change-me-strong-password@127.0.0.1:5432/tripsync
SYNC_DATABASE_URL=postgresql://tripsync:change-me-strong-password@127.0.0.1:5432/tripsync

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-64-char-random-access-secret-value-before-deploy
JWT_REFRESH_SECRET=replace-with-64-char-random-refresh-secret-value-before-deploy
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ─── App ───────────────────────────────────────────────────
APP_NAME=TravellersIn API
ENVIRONMENT=production
DEBUG=false
PORT=4010
FRONTEND_URL=https://travellersin.com
API_PREFIX=/api/v1

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://travellersin.com,https://www.travellersin.com,https://api.travellersin.com

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=30

# ─── AWS S3 ────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ─── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (ZeptoMail) ─────────────────────────────────────
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@travellersin.com
ZEPTOMAIL_FROM_NAME=TravellersIn

# ─── Email Fallback (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TEST_SECRET=

# ─── WhatsApp (MSG91) ──────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# ─── GST Verification ──────────────────────────────────────
GSTINCHECK_API_KEY=

# ─── DigiLocker ────────────────────────────────────────────
DIGILOCKER_VERIFY_URL=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# ─── Encryption ────────────────────────────────────────────
ENCRYPTION_KEY=

# ─── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
